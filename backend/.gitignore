# ==============================================
# Spring Boot / Maven Backend .gitignore
# ==============================================

# Maven build output
target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/

# ⚠️  NEVER commit real secrets
# Keep application.properties locally with real credentials.
# Commit only application-example.properties (template with placeholders).
src/main/resources/application.properties

# Log files
*.log
logs/

# OS files
.DS_Store
Thumbs.db
