# ==============================================
# React / Vite Frontend .gitignore
# ==============================================

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# ⚠️  NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vite cache
.vite/
*.local

# Editor directories
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
